 /**
+ * Hide every match of `sels`. Returns one match count per selector, positionally,
+ * or null if a selector is syntactically invalid. Per-selector rather than a
+ * total because a stale selector hides behind a working one in a sum: the total
+ * stays positive and the chrome that selector was meant to remove ships anyway.
+ */
+async function applyHides(page, sels) {
+  return page.evaluate((selectors) => {
+    const counts = [];
+    for (const sel of selectors) {
+      let nodes = [];
+      try {
+        nodes = document.querySelectorAll(sel);
+      } catch (_) {
+        return null; // invalid selector -> reported as a typed blocker
+      }
+      for (const el of nodes) el.style.setProperty('display', 'none', 'important');
+      counts.push(nodes.length);
+    }
+    return counts;
+  }, sels);
+}
+
+/**
+ * Browser-side half of --scroll: find the one scrollable body inside a device
+ * frame and move it. Serialized into the page, so it may not close over anything.
+ *
+ * A canvas screen does not advertise which node scrolls, and the frame contains
+ * several that merely overflow (a clipped decoration reports overflow and
+ * ignores scrollTop). So candidates are ranked by overflow and each is proven by
+ * assignment — set scrollTop and read it back — rather than trusted on its
+ * computed overflow-y. Scrolling the biggest overflowing node that actually
+ * moves is what makes the flag work without a per-screen selector argument.
+ */
+function scrollFrame({ frameSel, toEnd, px }) {
+  const frame = document.querySelector(frameSel);
+  if (!frame) return { frame: false };
+
+  const candidates = [];
+  for (const el of frame.querySelectorAll('*')) {
+    const over = el.scrollHeight - el.clientHeight;
+    if (over <= 1) continue;
+    const oy = getComputedStyle(el).overflowY;
+    if (oy === 'visible' || oy === 'clip') continue;
+    candidates.push({ el, over });
+  }
+  candidates.sort((a, b) => b.over - a.over);
+
+  for (const { el, over } of candidates) {
+    el.scrollTop = over;
+    if (el.scrollTop <= 0) continue;
+    const max = el.scrollHeight - el.clientHeight;
+    const target = toEnd ? max : Math.min(px, max);
+    el.scrollTop = target;
+    const cls = typeof el.className === 'string' ? el.className.trim().split(/\s+/)[0] : '';
+    return {
+      frame: true,
+      ok: true,
+      applied: Math.round(el.scrollTop),
+      max: Math.round(max),
+      clamped: !toEnd && px > max,
+      tag: el.tagName.toLowerCase() + (cls ? '.' + cls : ''),
+    };
+  }
+  return { frame: true, ok: false, examined: candidates.length };
+}
