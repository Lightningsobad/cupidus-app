  "info": {
    "title": "Cupid App Backend Integration API",
    "description": "The Cupid API description for Android, iOS, and Web clients.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "firebase-jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter Firebase JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "The display name of the user",
            "example": "John Doe"
          },
          "birthday": {
            "type": "string",
            "description": "The birthday of the user in ISO 8601 format",
            "example": "1990-01-01"
          },
          "relationshipStartDate": {
            "type": "string",
            "description": "The relationship start date in ISO 8601 format",
            "example": "2023-01-01"
          },
          "zodiacSign": {
            "type": "string",
            "description": "Zodiac sign",
            "example": "Aries"
          },
          "language": {
            "type": "string",
            "description": "Primary language",
            "example": "vi"
          },
          "photoUrl": {
            "type": "string",
            "description": "Avatar URL"
          },
          "coupleType": {
            "type": "string",
            "description": "Couple type",
            "enum": [
              "SAME_CITY",
              "LONG_DISTANCE",
              "LIVING_TOGETHER",
              "DATING"
            ]
          },
          "isGhostModeEnabled": {
            "type": "boolean",
            "description": "Is ghost mode enabled globally"
          }
        }
      },
      "CreateContractDto": {
        "type": "object",
        "properties": {
          "clauses": {
            "description": "List of contract clauses",
            "example": [
              "We will communicate openly",
              "We will prioritize each other"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "clauses"
        ]
      },
      "CreateGhostConfigDto": {
        "type": "object",
        "properties": {
          "timeoutMinutes": {
            "type": "number",
            "description": "Ghosting timeout in minutes (1-120)",
            "example": 10
          },
          "penalty": {
            "type": "string",
            "description": "Penalty type",
            "enum": [
              "emoji_storm",
              "noise",
              "none"
            ],
            "example": "emoji_storm"
          }
        },
        "required": [
          "timeoutMinutes",
          "penalty"
        ]
      },
      "CreateAlarmDto": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "description": "Alarm time in ISO 8601 format",
            "example": "2024-01-01T07:00:00.000Z"
          }
        },
        "required": [
          "time"
        ]
      },
      "CreateVibeDto": {
        "type": "object",
        "properties": {
          "mood": {
            "type": "string",
            "description": "Mood to check-in",
            "enum": [
              "happy",
              "sad",
              "angry",
              "horny",
              "tired"
            ],
            "example": "happy"
          },
          "note": {
            "type": "string",
            "description": "Optional mood note",
            "example": "Had a great day!"
          }
        },
        "required": [
          "mood"
        ]
      },
      "AdoptPetDto": {
        "type": "object",
        "properties": {
          "species": {
            "type": "string",
            "description": "Species of the pet",
            "enum": [
              "cat",
              "dog",
              "bunny"
            ],
            "example": "dog"
          },
          "name": {
            "type": "string",
            "description": "Name of the pet",
            "example": "Buddy",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "required": [
          "species",
          "name"
        ]
      },
      "CreateGalleryItemDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Encrypted filename or cloud reference ID"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the media"
          }
        },
        "required": [
          "filename"
        ]
      },
      "CreateTimelineEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Event title",
            "example": "First Date",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "Event description",
            "maxLength": 500
          },
          "photoUrl": {
            "type": "string",
            "description": "Photo URL associated with the event"
          },
          "icon": {
            "type": "string",
            "description": "Event icon name"
          },
          "type": {
            "type": "string",
            "description": "Event type",
            "enum": [
              "milestone",
              "memory",
              "system"
            ]
          },
          "date": {
            "type": "string",
            "description": "Date of the event (ISO string)"
          }
        },
        "required": [
          "title"
        ]
      },
      "CreateDreamJarDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the Dream Jar",
            "example": "Trip to Paris"
          },
          "targetAmount": {
            "type": "number",
            "description": "Target amount to save",
            "example": 50000000,
            "minimum": 1
          },
          "deadline": {
            "type": "string",
            "description": "Target date to reach the goal (ISO string)"
          },
          "currency": {
            "type": "string",
            "description": "Currency code",
            "example": "VND",
            "default": "VND"
          }
        },
        "required": [
          "name",
          "targetAmount"
        ]
      },
      "UpdateDreamJarDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the Dream Jar"
          },
          "targetAmount": {
            "type": "number",
            "description": "Target amount to save",
            "minimum": 1
          },
          "deadline": {
            "type": "string",
            "description": "Target date to reach the goal (ISO string)"
          },
          "status": {
            "type": "string",
            "description": "Status of the Dream Jar",
            "enum": [
              "active",
              "completed",
              "archived"
            ]
          }
        }
      },
      "AddContributionDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Contribution amount",
            "example": 500000,
            "minimum": 1
          },
          "note": {
            "type": "string",
            "description": "Optional note for this contribution"
          }
        },
        "required": [
          "amount"
        ]
      },
      "CreateExpenseDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Expense category",
            "enum": [
              "food",
              "date",
              "travel",
              "shopping",
              "other"
            ],
            "example": "food"
          },
          "amount": {
            "type": "number",
            "description": "Expense amount",
            "example": 250000,
            "minimum": 1
          },
          "description": {
            "type": "string",
            "description": "Optional description of the expense"
          },
          "date": {
            "type": "string",
            "description": "Date of the expense (ISO string, cannot be future date)",
            "example": "2023-10-25T14:30:00.000Z"
          }
        },
        "required": [
          "category",
          "amount",
          "date"
        ]
      },
      "UpdateConfigDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "description": "Configuration value (can be any type: string, number, boolean, object)"
          },
          "description": {
            "type": "string",
            "description": "Optional description or reason for update"
          }
        },
        "required": [
          "value"
        ]
      }
    }
  }
}
