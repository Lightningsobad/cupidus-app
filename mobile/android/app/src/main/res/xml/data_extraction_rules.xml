<?xml version="1.0" encoding="utf-8"?>
<!-- REQ-016 STORY-003 P2 / AC-9: Auto Backup + device-transfer rules for
     Android 12 (API 31) and higher, referenced from AndroidManifest as
     android:dataExtractionRules. See backup_rules.xml for the pre-12 schema
     and for what each domain resolves to.

     device-transfer repeats the same excludes on purpose. An omitted section
     is "fully enabled for all content", which would let a device-to-device
     migration carry the journal off this device — the pre-12 schema has no
     such split, so mirroring it keeps one behaviour across all API levels.

     Doc: https://developer.android.com/identity/data/autobackup -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="journal_media" />
        <exclude domain="root" path="app_flutter" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="journal_media" />
        <exclude domain="root" path="app_flutter" />
    </device-transfer>
</data-extraction-rules>
