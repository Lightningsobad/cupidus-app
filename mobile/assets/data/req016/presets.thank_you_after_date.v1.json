      "clauses": [
        { "text": "Cảm ơn cậu vì buổi hôm nay.", "requires": [], "targets": "neutral" },
        { "text": "Chỗ {place} yên, ngồi nói chuyện dễ ghê.", "requires": ["place"], "targets": "neutral" },
        { "text": "Tớ mà chọn chỗ thì chắc lại lạc đường thêm lần nữa.", "requires": [], "targets": "sender" },
        { "text": "Cậu thấy chỗ đó thế nào?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.thoi_gian.v1",
      "frame": "Cảm ơn thời gian",
      "clauses": [
        { "text": "Cảm ơn cậu đã dành cả buổi cho hôm nay.", "requires": [], "targets": "neutral" },
        { "text": "{duration} trôi nhanh thật.", "requires": ["duration"], "targets": "neutral" },
        { "text": "Tớ biết sắp xếp được một buổi không dễ.", "requires": [], "targets": "neutral" },
        { "text": "Giờ cậu đỡ mệt chưa?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.ke_lai.v1",
      "frame": "Kể lại một câu",
      "clauses": [
        { "text": "Cảm ơn cậu vì hôm nay nhé.", "requires": [], "targets": "neutral" },
        { "text": "Về tới nhà tớ vẫn kể lại buổi {activity} cho đứa bạn nghe.", "requires": ["activity"], "targets": "sender" },
        { "text": "Tớ cười hơi nhiều, giờ nghĩ lại vẫn thấy buồn cười.", "requires": [], "targets": "sender" },
        { "text": "Cậu kể cho ai chưa?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.ru_tiep_nhe.v1",
      "frame": "Rủ tiếp nhẹ",
      "clauses": [
        { "text": "Cảm ơn cậu vì buổi hôm nay nhé.", "requires": [], "targets": "neutral" },
        { "text": "Tớ đang định rủ cậu đi thêm một buổi nữa.", "requires": [], "targets": "sender" },
        { "text": "Lần này tớ tự tìm đường, không hỏi vòng vo như hôm nay.", "requires": [], "targets": "sender" },
        { "text": "Cậu thấy sao?", "requires": [], "targets": "neutral" },
        { "text": "Bận thì cậu nói thẳng nhé, tớ không phiền đâu.", "requires": [], "targets": "neutral", "role": "decline_door" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.hen_lan_sau.v1",
      "frame": "Hẹn lần sau",
      "clauses": [
        { "text": "Cảm ơn cậu, hôm nay tớ vui lắm.", "requires": [], "targets": "sender" },
        { "text": "Ngày {date} chắc tớ nhớ lâu.", "requires": ["date"], "targets": "sender" },
        { "text": "Hôm nào đó tớ rủ cậu đi một vòng nữa nhé?", "requires": [], "targets": "neutral" },
        { "text": "Không tiện thì cậu cứ nhắn một câu, mình để hôm khác.", "requires": [], "targets": "neutral", "role": "decline_door" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
