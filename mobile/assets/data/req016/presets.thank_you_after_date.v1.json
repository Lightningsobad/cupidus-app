  "items": [
    {
      "id": "thank_you_after_date.gon_gang.v1",
      "frame": "Gọn gàng",
      "clauses": [
        { "text": "Cảm ơn cậu vì buổi {activity} hôm nay nhé.", "requires": ["activity"], "targets": "neutral" },
        { "text": "Ngày {date} với tớ nhẹ hơn hẳn mọi ngày.", "requires": ["date"], "targets": "sender" },
        { "text": "Tớ về tới nhà rồi đây.", "requires": [], "targets": "sender" },
        { "text": "Cậu về tới nơi chưa?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.tu_cuoi_minh.v1",
      "frame": "Tự cười mình",
      "clauses": [
        { "text": "Cảm ơn cậu đã đi {activity} cùng tớ.", "requires": ["activity"], "targets": "neutral" },
        { "text": "Tớ vẫn còn ngượng vụ gọi nhầm tên món lúc nãy.", "requires": [], "targets": "sender" },
        { "text": "Lần sau tớ hứa đọc kỹ thực đơn trước khi mở miệng.", "requires": [], "targets": "sender" },
        { "text": "Hôm nay cậu thấy ổn chứ?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.nhe_nhang.v1",
      "frame": "Nhẹ nhàng",
      "clauses": [
        { "text": "Cảm ơn cậu vì buổi đi chơi hôm nay.", "requires": [], "targets": "neutral" },
        { "text": "Tớ thích kiểu đi chơi không vội thế này.", "requires": [], "targets": "sender" },
        { "text": "Ngồi {duration} mà tớ tưởng mới có một lúc.", "requires": ["duration"], "targets": "sender" },
        { "text": "Cậu nghỉ ngơi được chưa?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.tin_nhan_muon.v1",
      "frame": "Tin nhắn muộn",
      "clauses": [
        { "text": "Muộn rồi mà tớ vẫn muốn nhắn một câu cảm ơn.", "requires": [], "targets": "sender" },
        { "text": "Buổi {activity} hôm nay vui thật.", "requires": ["activity"], "targets": "neutral" },
        { "text": "Tớ nằm mãi chưa ngủ được, chắc tại còn vui.", "requires": [], "targets": "sender" },
        { "text": "Cậu ngủ ngon nhé, mai còn dậy sớm đúng không?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.nhac_chi_tiet.v1",
      "frame": "Nhắc một chi tiết",
      "clauses": [
        { "text": "Cảm ơn cậu vì hôm nay nha.", "requires": [], "targets": "neutral" },
        { "text": "Tớ vẫn nhớ đoạn {time} trời dịu hẳn đi.", "requires": ["time"], "targets": "sender" },
        { "text": "Tự dưng tớ nhớ mãi đoạn đó.", "requires": [], "targets": "sender" },
        { "text": "Cậu còn nhớ đoạn nào nữa không?", "requires": [], "targets": "neutral" }
      ],
      "editorial_review": {
        "layer1": "content.editor.vi.a",
        "layer2": "content.editor.vi.b",
        "approved_at": "2026-09-23"
      }
    },
    {
      "id": "thank_you_after_date.cho_hen.v1",
