{
  "id": "before_you_go",
  "version": "1.0.0",
  "schema_id": "req016.before_you_go.v1",
  "locale": "vi",
  "items": [
    {
      "id": "cash",
      "order": 10,
      "labelVi": "Mang đủ tiền mặt",
      "icon": "payments",
      "when": [
        { "field": "priceVnd", "op": "gt", "value": 0 }
      ]
    },
    {
      "id": "fuel",
      "order": 20,
      "labelVi": "Đổ xăng hoặc sạc pin trước khi đi",
      "icon": "local_gas_station",
      "when": [
        { "field": "distanceKm", "op": "gte", "value": 10 }
      ]
    },
    {
      "id": "rain",
      "order": 30,
      "labelVi": "Mang áo mưa/ô, có phương án B trong nhà",
      "icon": "umbrella",
      "when": [
        { "field": "indoorOutdoor", "op": "eq", "value": "outdoor" },
        { "field": "rainySeason", "op": "isTrue" }
      ]
    },
    {
      "id": "booking",
      "order": 40,
      "labelVi": "Gọi đặt chỗ trước",
      "icon": "event_available",
      "when": [
        { "field": "needsBooking", "op": "isTrue" }
      ]
    },
    {
      "id": "share_location",
      "order": 50,
      "labelVi": "Chia sẻ vị trí",
      "icon": "share_location",
      "action": "share_location",
      "when": [
        { "field": "always", "op": "isTrue" }
      ]
    }
  ],
