.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated ARB localization output (ADR-004e) — regenerated by
# `flutter gen-l10n` (runs via `flutter pub get`), not committed.
# `untranslated-messages-file` resolves relative to the project root, not
# `output-dir` (confirmed in flutter_tools gen_l10n.dart
# `_untranslatedMessagesFileFromPath`).
/lib/l10n/generated/
/l10n-untranslated.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
