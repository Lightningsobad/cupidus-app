# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
NODE_ENV=development
PORT=3000
HOST=localhost

# ---------------------------------------------
# Database Configuration (PostgreSQL / TypeORM)
# ---------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cupid

# Connection string (optional / devstack format)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/cupid

# ---------------------------------------------
# Redis Configuration (Devstack / Cache)
# ---------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PREFIX=cupid-apps:
# REDIS_URL=redis://127.0.0.1:6379/1

# ---------------------------------------------
# Docker Compose Local Ports (Optional)
# ---------------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
BACKEND_HOST_PORT=3000

