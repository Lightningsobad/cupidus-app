---
// Port of Cupid Web.dc.html lines 485-494 (one `<sc-for list="{{ posts }}">`
// iteration). Presentational tile only: no link wrapper, no per-article route.
import type { Post } from '../../data/blog-content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---
<div class="cupid-article-card" style="background:var(--surf);border:1px solid var(--c1);border-radius:26px;padding:26px;display:flex;flex-direction:column;gap:12px">
<div style={`display:inline-flex;align-self:start;background:${post.tint};border-radius:999px;padding:5px 12px;font-family:'Roboto Mono';font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:${post.color}`}><span data-vi>{post.cvi}</span><span data-en>{post.cen}</span></div>
<h3 style="font-family:Nunito;font-weight:800;font-size:20px;line-height:1.25;color:var(--ink);text-wrap:pretty;margin:0"><span data-vi>{post.tvi}</span><span data-en>{post.ten}</span></h3>
<div style="font-size:13.5px;line-height:1.6;color:var(--c6);flex:1"><span data-vi>{post.dvi}</span><span data-en>{post.den}</span></div>
<div style="display:flex;align-items:center;gap:9px;border-top:1px solid var(--c09);padding-top:13px">
<div aria-hidden="true" style={`width:26px;height:26px;border-radius:50%;background:${post.avatar}`}></div>
<div style="font-family:Nunito;font-weight:700;font-size:12.5px;color:var(--c76)">{post.author}</div>
<div style="font-family:'Roboto Mono';font-size:10.5px;color:var(--c4);margin-left:auto">{post.read} <span data-vi>phút</span><span data-en>min</span></div>
</div>
</div>

<style>
/* style-hover port of Cupid Web.dc.html line 485. `border-color` needs
   !important because the card sets the `border` shorthand inline; `transform`
   carries it too so both halves of the one source declaration stay symmetrical. */
.cupid-article-card:hover{border-color:rgba(255,127,182,.36) !important;transform:translateY(-4px) !important}
</style>
