---
// Ported from `cupid-app-design-system/Xoai Sprite.dc.html`, default `state="happy"`
// branch (lines 20-40) only. SVG id namespaced `xoFurA` -> `cupid-xoai-fur`.
interface Props {
  size?: number;
}
const { size = 120 } = Astro.props;
---

<div
  class="cupid-sprite"
  style={`width:${size}px;height:${size}px;display:flex;align-items:center;justify-content:center`}
  role="img"
  aria-label="Xoài"
>
  <svg viewBox="0 0 200 200" style="width:100%;height:100%;overflow:visible;animation:xoBob 3s ease-in-out infinite">
    <defs><linearGradient id="cupid-xoai-fur" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFF0B8"></stop><stop offset="1" stop-color="#FFC53D"></stop></linearGradient></defs>
    <path d="M92 44 L86 24" stroke="#FFD75E" stroke-width="7" stroke-linecap="round"></path>
    <path d="M100 42 L100 20" stroke="#FFD75E" stroke-width="7" stroke-linecap="round"></path>
    <path d="M108 44 L114 24" stroke="#FFD75E" stroke-width="7" stroke-linecap="round"></path>
    <path d="M100 44C137 44 159 72 159 107C159 143 134 165 100 165C66 165 41 143 41 107C41 72 63 44 100 44Z" fill="url(#cupid-xoai-fur)"></path>
    <g style="transform-origin:46px 104px;animation:xoFlap 1.1s ease-in-out infinite"><ellipse cx="44" cy="112" rx="11" ry="21" transform="rotate(-14 44 112)" fill="#FFD75E"></ellipse></g>
    <g style="transform-origin:154px 104px;animation:xoFlap 1.1s ease-in-out infinite"><ellipse cx="156" cy="112" rx="11" ry="21" transform="rotate(14 156 112)" fill="#FFD75E"></ellipse></g>
    <ellipse cx="79" cy="163" rx="14" ry="7" fill="#FF9A3D"></ellipse>
    <ellipse cx="121" cy="163" rx="14" ry="7" fill="#FF9A3D"></ellipse>
    <path d="M69 106 Q78 93 87 106" stroke="#6B4A12" stroke-width="6.5" stroke-linecap="round" fill="none"></path>
    <path d="M113 106 Q122 93 131 106" stroke="#6B4A12" stroke-width="6.5" stroke-linecap="round" fill="none"></path>
    <ellipse cx="60" cy="122" rx="10" ry="6" fill="#FF8FB8" opacity="0.5"></ellipse>
    <ellipse cx="140" cy="122" rx="10" ry="6" fill="#FF8FB8" opacity="0.5"></ellipse>
    <path d="M100 114 L110 122 L90 122 Z" fill="#FF9A3D" stroke="#FF9A3D" stroke-width="3" stroke-linejoin="round"></path>
    <path d="M100 126 Q100 134 94 132" stroke="#E0842F" stroke-width="3.5" stroke-linecap="round" fill="none"></path>
    <path d="M8 0C8.6 4.6 11.4 7.4 16 8C11.4 8.6 8.6 11.4 8 16C7.4 11.4 4.6 8.6 0 8C4.6 7.4 7.4 4.6 8 0Z" fill="#FFFFFF" transform="translate(24,52) scale(0.85)" style="animation:xoDrift 9s ease-in-out infinite"></path>
    <path d="M8 0C8.6 4.6 11.4 7.4 16 8C11.4 8.6 8.6 11.4 8 16C7.4 11.4 4.6 8.6 0 8C4.6 7.4 7.4 4.6 8 0Z" fill="#FFF3C4" transform="translate(172,64) scale(0.6)" style="animation:xoDrift 11s ease-in-out 1.5s infinite"></path>
  </svg>
</div>

<!-- `is:global` because the `animation:` declarations live in inline `style`
     attributes, which Astro's scoped-style transform never rewrites. -->
<style is:global>
@keyframes xoBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes xoDrift{0%{transform:translate(0,0) rotate(0)}50%{transform:translate(5px,-8px) rotate(9deg)}100%{transform:translate(0,0) rotate(0)}}
@keyframes xoFlap{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(14deg)}}
</style>
