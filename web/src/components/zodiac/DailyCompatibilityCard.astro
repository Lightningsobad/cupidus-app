---
// Port of Cupid Web.dc.html lines 292-320.
//
// The source hardcodes 92 twice — once as the conic-gradient stop, once as the
// disc text. Both are derived from `DAILY_READ.score` here so the ring can never
// disagree with the number it displays.
import { DAILY_READ, signByKey } from '../../data/zodiac';
import ZodiacIcon from '../sprites/ZodiacIcon.astro';

const score = DAILY_READ.score;
const first = signByKey(DAILY_READ.pair[0]);
const second = signByKey(DAILY_READ.pair[1]);
---
<div style="margin-top:38px;background:linear-gradient(150deg,rgba(255,201,126,.18),rgba(183,140,245,.16));border:1px solid var(--c13);border-radius:34px;padding:38px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:36px;align-items:center">
<div style="display:flex;align-items:center;justify-content:center;gap:22px">
<div style="text-align:center">
<div style="width:86px;margin:0 auto"><ZodiacIcon sign={first.key} size={86} /></div>
<div style="font-family:Nunito;font-weight:800;font-size:15px;color:var(--ink);margin-top:10px"><span data-vi>{first.vi}</span><span data-en>{first.en}</span></div>
</div>
<div style="display:flex;flex-direction:column;align-items:center;gap:6px">
<div style={`width:104px;height:104px;border-radius:50%;background:conic-gradient(#FFC97E 0% ${score}%,var(--c1) ${score}% 100%);display:grid;place-items:center`}>
<div style="width:82px;height:82px;border-radius:50%;background:var(--screen);display:grid;place-items:center;font-family:Nunito;font-weight:900;font-size:24px;color:var(--ink)">{score}%</div>
</div>
<div style="font-family:'Roboto Mono';font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--c5)"><span data-vi>{DAILY_READ.captionVi}</span><span data-en>{DAILY_READ.captionEn}</span></div>
</div>
<div style="text-align:center">
<div style="width:86px;margin:0 auto"><ZodiacIcon sign={second.key} size={86} /></div>
<div style="font-family:Nunito;font-weight:800;font-size:15px;color:var(--ink);margin-top:10px"><span data-vi>{second.vi}</span><span data-en>{second.en}</span></div>
</div>
</div>
<div style="display:flex;flex-direction:column;gap:16px">
{DAILY_READ.metrics.map((m) => (
<div>
<div style="display:flex;justify-content:space-between;font-size:12.5px;color:var(--c7);margin-bottom:6px"><span><span data-vi>{m.vi}</span><span data-en>{m.en}</span></span><span style={`font-family:'Roboto Mono';color:${m.textColor}`}>{m.value}%</span></div>
<div style="height:7px;border-radius:999px;background:var(--c09);overflow:hidden"><div style={`width:${m.value}%;height:100%;border-radius:999px;background:${m.barColor}`}></div></div>
</div>
))}
<div style="background:var(--inner);border:1px solid var(--c11);border-radius:20px;padding:18px">
<div style="font-family:'Roboto Mono';font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--acc-butter)"><span data-vi>{DAILY_READ.nudgeLabelVi}</span><span data-en>{DAILY_READ.nudgeLabelEn}</span></div>
<div style="font-size:13.5px;line-height:1.6;color:var(--c78);margin-top:8px"><span data-vi>{DAILY_READ.nudgeBodyVi}</span><span data-en>{DAILY_READ.nudgeBodyEn}</span></div>
</div>
</div>
</div>
