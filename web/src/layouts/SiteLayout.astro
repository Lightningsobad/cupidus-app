---
import type { PageKey } from '../data/site-nav';
import NebulaBackdrop from '../components/shell/NebulaBackdrop.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
// Inlined as raw text so the boot script stays render-blocking and un-bundled.
import themeLangBoot from '../scripts/theme-lang-boot.ts?raw';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  page: PageKey;
  title?: string;
  description?: string;
}

const { page, title = 'Cupid', description } = Astro.props;
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..600,0..1,-25..0&display=block" rel="stylesheet">
</head>
<body data-theme="dark" data-lang="vi">
<script is:inline set:html={themeLangBoot} />
<div style="min-height:100vh;position:relative;overflow-x:hidden">
<NebulaBackdrop />
<SiteHeader page={page} />
<main><slot /></main>
<SiteFooter />
</div>
</body>
</html>
