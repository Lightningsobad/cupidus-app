  "cards": [
    {
      "dot": "cyan",
      "title": "XÁC NHẬN • Các tầng",
      "items": [
        "Presentation gọi repository cụ thể; ChatCubit còn nghe coordinator.status.",
        "GetIt là composition root; singleton và factory có vòng đời khác nhau.",
        "Mũi tên thể hiện lời gọi/phụ thuộc; stream phát ngược về UI."
      ]
    },
    {
      "dot": "emerald",
      "title": "XÁC NHẬN • Luồng chính",
      "items": [
        "Splash: chưa đăng nhập → Welcome; phiên hết hạn → Login; đã đăng nhập → return gate → pair gate.",
        "Pair gate: paired → AppShell; unpaired → Home solo; lỗi mạng → retry.",
        "Chat: socket ACK → upsert Drift → watchThread → emit UI; ACK thiếu → REST resync.",
        "Gallery: upload file rồi tạo item; đọc lỗi mạng → cache có isStale."
      ]
    },
    {
      "dot": "violet",
      "title": "Module theo thư mục • nhóm do người phân tích đặt",
      "items": [
        "Truy cập: auth, onboarding, pairing, account, love_contracts, vow.",
        "Tương tác: chat, emojis, anti_ghosting, vibes, reminders, in_app_notifications.",
        "Đời sống chung: home, pet, timeline, gallery, dream_jar, expenses, themes.",
        "Nội dung/cá nhân: activity_cards, journal, context_notebook, invite_composer, conversation_starters, date_script, gift_ideas, compatibility_lookup, your_view_portrait, zodiac, zodiac_shell, phase_status, before_you_go, chapter_closure."
      ]
    },
    {
      "dot": "amber",
      "title": "SUY LUẬN & giới hạn",
      "items": [
        "Có thể gọi đây là kiến trúc feature-first nhiều tầng; không đủ cơ sở gọi Clean Architecture thuần.",
        "Các nhóm module là phân loại phân tích, không phải boundary runtime được code khai báo.",
        "Không suy diễn nội bộ backend, độ bền server hay đảm bảo giao nhận từ client.",
        "Bản đồ ở mức subsystem; báo cáo kèm theo giải thích state và dẫn chứng chi tiết.",
        "Nội dung tiếng Việt; Viewer dùng giao diện English fallback."
      ]
    }
  ]
}